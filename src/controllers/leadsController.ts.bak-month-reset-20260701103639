import { sendWhatsAppText } from "../lib/whatsappProvider";

function getId(param: any): string { return Array.isArray(param) ? param[0] : param; }
function onlyDigits(value: any) { return String(value || "").replace(/\D/g, ""); }
function clean(value: any, fallback = "") { return String(value ?? fallback).trim(); }
function cents(value: unknown) {
  const number = Number(String(value || "").replace(",", "."));
  if (!Number.isFinite(number)) return 0;
  return Math.max(0, Math.round(number * 100));
}
function moneyFromCents(value: number) {
  return Number(value || 0) / 100;
}
function slugify(value: string) {
  return value.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "").slice(0, 48) || "empresa";
}
async function ensureCompanySlug(companyId: string, name?: string | null) {
  const company = await prisma.company.findUnique({ where: { id: companyId }, select: { id: true, name: true, publicSlug: true } });
  if (!company) return "";
  if (company.publicSlug) return company.publicSlug;
  const base = slugify(name || company.name);
  for (let i = 0; i < 20; i++) {
    const candidate = i === 0 ? base : base + "-" + (i + 1);
    const exists = await prisma.company.findFirst({ where: { publicSlug: candidate, NOT: { id: companyId } }, select: { id: true } });
    if (!exists) {
      await prisma.company.update({ where: { id: companyId }, data: { publicSlug: candidate } });
      return candidate;
    }
  }
  const fallback = base + "-" + companyId.slice(-6);
  await prisma.company.update({ where: { id: companyId }, data: { publicSlug: fallback } });
  return fallback;
}
function leadPayload(body: any) {
  const phone = onlyDigits(body.phone || body.whatsapp || body.telefone);
  const message = clean(body.message || body.caseDescription || body.caso || body.description, "Lead capturado pela landing page.");
  return {
    phone,
    contactName: clean(body.contactName || body.name || body.nome) || null,
    message,
    city: clean(body.city || body.cidade) || null,
    area: clean(body.area || body.practiceArea || body.tipoCaso) || null,
    urgency: clean(body.urgency || body.urgencia) || null,
    source: clean(body.source || body.utm_source || "landing") || null,
    campaign: clean(body.campaign || body.utm_campaign) || null,
    keyword: clean(body.keyword || body.utm_term) || null,
    pageUrl: clean(body.pageUrl || body.url || body.referrer) || null,
    device: clean(body.device || body.dispositivo) || null,
    capturedFrom: clean(body.capturedFrom || "landing_page"),
    stage: clean(body.stage || "novo"),
    status: clean(body.status || "novo"),
  };
}
function legalUrgencyText(lead: any) {
  return [lead.urgency, lead.area, lead.message].join(" ").toLowerCase();
}
function hasImmediateRisk(lead: any) {
  const text = legalUrgencyText(lead);
  return /urgente|agora|preso|prisão|prisao|flagrante|mandado|audiência|audiencia|custódia|custodia|delegacia|habeas|intimação|intimacao|policial|violência|violencia|maria da penha|medida protetiva|ameaça|ameaca/.test(text);
}
function calculateLeadScore(lead: any) {
  const text = legalUrgencyText(lead);
  let score = 35;
  if (onlyDigits(lead.phone).length >= 10) score += 10;
  if (lead.city) score += 8;
  if (lead.area) score += 12;
  if (String(lead.message || "").length > 24) score += 12;
  if (hasImmediateRisk(lead)) score += 23;
  if (/brasília|brasilia|df/.test(String(lead.city || "").toLowerCase())) score += 5;
  if (/b\.o|boletim|orientação|orientacao/.test(text)) score += 5;
  return Math.max(0, Math.min(100, score));
}
function isUrgentLead(lead: any) {
  return hasImmediateRisk(lead);
}
function firstName(name: any) {
  return clean(name).split(/\s+/).filter(Boolean)[0] || "";
}
function buildLauraIntakeMessage(lead: any, urgent: boolean) {
  const name = firstName(lead.contactName);
  const greeting = name ? "Olá, " + name + "." : "Olá.";
  const topic = lead.urgency ? " sobre " + String(lead.urgency).toLowerCase() : "";
  const intro = greeting + " Eu sou a Laura, assistente do escritório.";
  const text = legalUrgencyText(lead);
  if (/violência|violencia|maria da penha|medida protetiva|ameaça|ameaca/.test(text)) {
    return intro + " Recebi seu contato" + topic + ". Sinto muito por você estar passando por isso. Antes de avançar: você está em um local seguro agora?";
  }
  if (/habeas|preso|prisão|prisao|flagrante|custódia|custodia/.test(text)) {
    return intro + " Recebi seu contato" + topic + " e vou organizar para o advogado. Quem está preso ou com audiência marcada agora?";
  }
  if (/intimação|intimacao|policial|delegacia/.test(text)) {
    return intro + " Recebi seu contato" + topic + " e vou organizar para o advogado. A intimação é para qual data?";
  }
  if (urgent) {
    return intro + " Recebi seu contato e vou priorizar. Me conta um pouco mais sobre o que aconteceu?";
  }
  return intro + " Recebi seu contato" + topic + ". Me conta um pouco mais sobre o que aconteceu para eu organizar melhor para o advogado.";
}
function buildLeadSummary(lead: any) {
  return [
    lead.contactName ? "Nome: " + lead.contactName : "Nome: não informado",
    lead.phone ? "WhatsApp: " + lead.phone : "WhatsApp: não informado",
    lead.city ? "Cidade: " + lead.city : "Cidade: não informada",
    lead.area ? "Tipo de caso: " + lead.area : "Tipo de caso: não informado",
    lead.urgency ? "Urgência: " + lead.urgency : "Urgência: não informada",
    lead.message ? "Relato: " + lead.message : "Relato: não informado",
    lead.source ? "Origem: " + lead.source : "Origem: landing",
    lead.campaign ? "Campanha: " + lead.campaign : "",
    lead.keyword ? "Termo: " + lead.keyword : "",
  ].filter(Boolean).join("\n");
}
function buildLawyerHandoffText(company: any, lead: any, score: number, urgent: boolean) {
  const action = urgent || score >= 80
    ? "Acionar agora. Lead com sinal de urgência ou alta intenção."
    : "Responder assim que possível. Lead já organizado pela Laura.";
  return [
    "Novo lead capturado pelo StayGoBot",
    "",
    "Empresa: " + (company.name || "escritório"),
    "Score: " + score + "/100" + (urgent ? " - urgente" : ""),
    "Ação sugerida: " + action,
    "",
    buildLeadSummary(lead),
    "",
    "Mensagem curta sugerida:",
    "Olá, aqui é do escritório. Recebi seu contato pelo atendimento da Laura. Pode me contar em uma frase o que aconteceu agora?",
  ].filter(Boolean).join("\n");
}
async function createLeadConversation(companyId: string, lead: any, score: number, urgent: boolean) {
  const tags = ["landing", "laura", urgent ? "urgente" : "triagem", score >= 80 ? "lead_score_alto" : "lead_score_medio"].join(", ");
  const summary = buildLeadSummary(lead);
  const conversation = await prisma.conversation.create({
    data: {
      companyId,
      leadId: lead.id,
      contactName: lead.contactName,
      phone: lead.phone,
      tags,
      notes: "Lead capturado pela landing pública.\n\n" + summary,
      unreadCount: 1,
      lastMessageText: lead.message,
      lastMessageAt: new Date(),
      isHot: urgent || score >= 80,
      followUpStatus: "none",
    },
  });
  await prisma.message.createMany({ data: [
    { companyId, conversationId: conversation.id, direction: "inbound", body: lead.message, status: "received" },
    { companyId, conversationId: conversation.id, direction: "system", body: buildLauraIntakeMessage(lead, urgent), status: "ai_intake" },
  ] });
  return conversation;
}

async function findLeadForwardingInstance(companyId: string) {
  const instances = await prisma.whatsappInstance.findMany({
    where: { companyId },
    orderBy: { createdAt: "asc" },
  });
  return (
    instances.find((instance) =>
      instance.provider === "meta_cloud_api" &&
      Boolean(instance.metaPhoneNumberId) &&
      Boolean(instance.metaAccessToken)
    ) ||
    instances.find((instance) =>
      instance.provider !== "meta_cloud_api" &&
      String(instance.status || "").toLowerCase() === "connected"
    ) ||
    null
  );
}

async function forwardLeadToAttorney(company: any, lead: any, conversationId: string, score: number, urgent: boolean) {
  const destination = onlyDigits(company.leadWhatsappNumber);
  if (!destination) {
    await prisma.message.create({
      data: {
        companyId: company.id,
        conversationId,
        direction: "system",
        body: "Repasse manual pendente: configure o WhatsApp do advogado para usar o botão de encaminhamento.",
        status: "internal_handoff_pending",
      },
    });
    return { status: "no_destination", provider: null, providerMessageId: null };
  }

  const instance = await findLeadForwardingInstance(company.id);
  if (!instance) {
    await prisma.message.create({
      data: {
        companyId: company.id,
        conversationId,
        direction: "system",
        body: "Lead pronto para o advogado. Use o botão Abrir WhatsApp para enviar o resumo já preenchido.",
        status: "internal_handoff_ready",
      },
    });
    return { status: "no_instance", provider: null, providerMessageId: null };
  }

  const text = buildLawyerHandoffText(company, lead, score, urgent);
  try {
    const sent = await sendWhatsAppText(instance, destination, text);
    await prisma.message.create({
      data: {
        companyId: company.id,
        conversationId,
        direction: "system",
        body: "Laura encaminhou este lead automaticamente para o WhatsApp do advogado: " + destination,
        status: "internal_handoff_sent",
        providerMessageId: sent?.id || null,
      },
    });
    return { status: "sent", provider: sent?.provider || instance.provider, providerMessageId: sent?.id || null };
  } catch (error: any) {
    console.error("Erro forwardLeadToAttorney:", error);
    await prisma.message.create({
      data: {
        companyId: company.id,
        conversationId,
        direction: "system",
        body: "Lead pronto para repasse manual. O envio automático falhou e o botão Abrir WhatsApp mantém o resumo disponível.",
        status: "internal_handoff_ready",
      },
    });
    return { status: "failed", provider: instance.provider, providerMessageId: null, error: error?.message || "erro desconhecido" };
  }
}

function whatsappUrl(phone: string, lead: any) {
  const to = onlyDigits(phone);
  if (!to) return "";
  const lines = [
    "Novo lead vindo pelo StayGoBot.",
    lead.contactName ? "Nome: " + lead.contactName : "",
    lead.phone ? "Telefone: " + lead.phone : "",
    lead.city ? "Cidade: " + lead.city : "",
    lead.area ? "Tipo de caso: " + lead.area : "",
    lead.urgency ? "Urgência: " + lead.urgency : "",
    lead.message ? "Resumo: " + lead.message : "",
    lead.source ? "Origem: " + lead.source : "",
    lead.campaign ? "Campanha: " + lead.campaign : "",
    lead.keyword ? "Termo: " + lead.keyword : "",
  ].filter(Boolean);
  return "https://wa.me/" + to + "?text=" + encodeURIComponent(lines.join("\n"));
}

export async function createLead(req: Request, res: Response) {
  try {
    const companyId = req.auth!.companyId;
    const payload = leadPayload(req.body || {});
    if (!payload.phone) return res.status(400).json({ error: "Informe o telefone do lead." });
    const lead = await prisma.lead.create({ data: { ...payload, companyId } });
    return res.json(lead);
  } catch (error) {
    console.error("Erro createLead:", error);
    return res.status(500).json({ error: "Erro ao criar lead." });
  }
}

